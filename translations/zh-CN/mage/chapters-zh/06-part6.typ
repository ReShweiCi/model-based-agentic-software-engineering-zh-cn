  table(
    columns: (22%, 39%, 39%),
    table.header([建模 ↓ / 对齐 →], [无对齐], [有对齐]),
    table.hline(),
    [无建模], [在劣质推理表面上反复推理；残余失败可能逃逸], [被覆盖的失败无法逃逸，但拒绝与重新生成的代价可能高昂],
